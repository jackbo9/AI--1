AUTH_MODE=local

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

IMAGE_PROVIDER=seedream
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com
IMAGE_API_KEY=
IMAGE_MODEL=doubao-seedream-5-0-260128
# 当前已验证 2K + 构图 Prompt 可返回 1600×2848（约 9:16）。
# 只有在方舟确认当前模型接受明确宽高后，才改为如 1600x2848。
IMAGE_SIZE=2K
# editorial: 精简视觉指导；legacy: 回退构图指导，仍保留确认文本不被覆盖的修复。
VISUAL_STYLE_MODE=editorial
READABILITY_MODE=trial

# OpenAI Images 兼容网关示例。切换时替换上面的 IMAGE_* 值，不要同时保留两套生效配置：
# IMAGE_PROVIDER=openai-images
# IMAGE_BASE_URL=https://ai.zjsinnet-cloud.com
# IMAGE_API_KEY=
# IMAGE_MODEL=gpt-image-2
# IMAGE_SIZE=1024x1792

FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://10.6.4.183:3000/api/auth/feishu/callback
FEISHU_OAUTH_SCOPE=
SESSION_SECRET=

NEXT_PUBLIC_APP_URL=http://10.6.4.183:3000
